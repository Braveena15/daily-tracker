# Copy this file to .env and fill in your own values. Never commit .env.

PORT=4000
NODE_ENV=development
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/daily-tracker?retryWrites=true&w=majority

# Secret used to sign login tokens. At least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters

# Set to "true" to allow new sign-ups. Anything else closes registration.
ALLOW_REGISTRATION=true

# Encrypts diary and thought-log text (AES-256-GCM). Exactly 64 hex characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Keep a safe backup: if this key is lost or changed, encrypted entries can't be read again.
DIARY_ENCRYPTION_KEY=

# The URL the React client runs on (allowed by CORS)
CLIENT_URL=http://localhost:5173
